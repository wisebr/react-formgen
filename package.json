{
  "name": "react-formgen",
  "version": "2.0.0",
  "description": "Form generator and renderer built on React and MUI",
  "main": "dist/react-formgen.mjs",
  "module": "dist/react-formgen.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-formgen.mjs",
      "default": "./dist/react-formgen.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "test": "jest",
    "build": "npm run build:modern",
    "build:modern": "rollup -c",
    "link:peers": "node ./scripts/link-peers.js",
    "start": "npm link && npm run link:peers && (cd ./app && npm link react-formgen) && rollup -cw & (cd ./app && npm start)",
    "prettier": "prettier --write './src/**/*.ts' './src/**/*.tsx' --config ./.prettierrc",
    "lint": "tslint --project ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisebr/react-formgen.git"
  },
  "author": "https://github.com/wisebr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wisebr/react-formgen/issues"
  },
  "homepage": "https://github.com/wisebr/react-formgen#readme",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@rollup/plugin-json": "^6.1.0",
    "@types/classnames": "^2.2.9",
    "@types/jest": "^25.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shortid": "0.0.29",
    "prettier": "^1.19.1",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "rollup": "^4.64.12",
    "rollup-plugin-typescript2": "^0.37.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "ts-jest": "^29.4.15",
    "tslint": "^6.1.2",
    "tslint-react": "^5.0.0",
    "tslint-react-hooks": "^2.2.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "classnames": "^2.2.6",
    "dayjs": "^1.11.10",
    "shortid": "^2.2.15"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^7.3.11 || ^9.5.0",
    "@mui/material": "^7.3.11 || ^9.5.0",
    "@mui/x-date-pickers": "^8.0.0 || ^9.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-hook-form": "^7.53.0"
  }
}
